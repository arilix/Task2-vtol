<launch>
    <!-- 
        Square Mission Only (tanpa MAVROS)
        Gunakan ini jika MAVROS sudah berjalan di terminal lain.
    -->

    <node pkg="drone_mission" type="square_mission.py" name="square_mission_node" output="screen">
        <param name="square_size" value="2.0" />
        <param name="altitude"    value="2.0" />
        <param name="threshold"   value="0.3" />
        <param name="rate"        value="20"  />
    </node>
</launch>
